# Copy to .env and fill in. Every setting can also be set as a real environment variable.

# --- Analysis engine ----------------------------------------------------------
# auto  = use Claude when credentials are present, otherwise the deterministic rules engine
# llm   = require Claude (fail if unavailable)
# rules = deterministic, offline, no API calls
TDIP_ENGINE=auto
ANTHROPIC_API_KEY=
# TDIP_LLM_MODEL=claude-opus-5
# TDIP_LLM_EFFORT=high
# TDIP_LLM_MAX_TOKENS=64000
# TDIP_LLM_TIMEOUT_SECONDS=600
# TDIP_LLM_SERVER_FALLBACKS=true     # server-side refusal fallbacks (beta)
# TDIP_LLM_ATTACH_PDF=true           # send the PDF itself so diagrams are visible
# TDIP_LLM_ATTACH_MAX_MB=20

# --- Ingestion ----------------------------------------------------------------
# TDIP_MAX_UPLOAD_MB=50
# TDIP_MAX_SLIDES=250
# TDIP_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe   # needed for legacy .ppt

# --- Scoring ------------------------------------------------------------------
# Score given to a category with no deck evidence (1-3). Default 2 = unverified.
# TDIP_UNVERIFIED_SCORE=2

# --- Output -------------------------------------------------------------------
# TDIP_OUTPUT_DIR=output
# TDIP_FONT_DIR=app/assets/fonts     # folder with OpenSans-Regular/Bold/Italic.ttf
# TDIP_LOG_LEVEL=INFO
# TDIP_LOG_FILE=logs/tdip.log

# --- Automated result emails (Resend) -------------------------------------------
# Every completed analysis is emailed (summary + PDF + analysis JSON). The uploader's
# email and the lead record are included only when they tick the consent box.
# The From domain must be verified in Resend.
RESEND_API_KEY=
# TDIP_REPORT_EMAIL_TO=Info@tencapital.group           # comma-separated for several
# TDIP_REPORT_EMAIL_FROM=TEN Capital Tech & IP Diligence <reports@tencapital.group>
# TDIP_EMAIL_REPORTS=false                              # switch off without removing the key

# --- TEN Capital lead-intelligence record --------------------------------------
# The record is always written locally. It is transmitted ONLY when the user
# explicitly consents for that run (CLI flag or web checkbox). Consent cannot be
# granted through configuration.
# TDIP_TEN_CAPITAL_ENDPOINT=https://intake.example.com/tech-ip-diligence
# TDIP_TEN_CAPITAL_API_KEY=
# TDIP_TEN_CAPITAL_TIMEOUT_SECONDS=15
# TDIP_DEFAULT_USER=

# --- Web server ---------------------------------------------------------------
# Strongly recommended on any public deployment: every upload spends API credits.
# Browsers prompt for it (any username, this password).
# TDIP_APP_PASSWORD=
# TDIP_WEB_HOST=127.0.0.1
# TDIP_WEB_PORT=8040
# TDIP_WEB_MAX_CONCURRENT_JOBS=2
# TDIP_WEB_JOB_TTL_MINUTES=60
